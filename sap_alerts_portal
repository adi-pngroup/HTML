<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>ניהול התראות SAP</title>
    <style>
        /* (העיצוב נשאר זהה לפורטל הקודם לנוחותך) */
        body { font-family: Arial, sans-serif; background-color: #f5f7fa; padding: 20px; display: flex; justify-content: center; }
        .form-container { background-color: #fff; padding: 30px; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); width: 100%; max-width: 600px; }
        h2 { text-align: center; color: #2c3e50; border-bottom: 2px solid #4a90e2; padding-bottom: 10px; }
        .form-group { margin-bottom: 20px; }
        label { display: block; font-weight: bold; margin-bottom: 8px; }
        select, input { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px; }
        button { width: 100%; padding: 12px; background-color: #4a90e2; color: white; border: none; border-radius: 4px; cursor: pointer; }
        #userSelectionSection { display: none; }
    </style>
</head>
<body>

<div class="form-container">
    <h2>ניהול מנויי התראות</h2>
    <form id="alertForm">
        <!-- בחירת התראה -->
        <div class="form-group">
            <label for="alertSelect">בחר התראה *</label>
            <select id="alertSelect" name="alertName" required>
                <option value="">-- טוען התראות... --</option>
            </select>
        </div>

        <!-- בחירת פעולה -->
        <div class="form-group">
            <label for="actionSelect">בחר פעולה *</label>
            <select id="actionSelect" name="action" required onchange="toggleUserSection()">
                <option value="">-- נא לבחור פעולה --</option>
                <option value="ADD">הוספת נמען להתראה</option>
                <option value="REMOVE">הסרת נמען מהתראה</option>
                <option value="DISABLE">ביטול פעילות התראה</option>
            </select>
        </div>

        <!-- בחירת משתמש (יופיע רק אם בחרנו הוספה או הסרה) -->
        <div id="userSelectionSection" class="form-group">
            <label for="userSelect">בחר משתמש *</label>
            <select id="userSelect" name="userName">
                <option value="">-- טוען משתמשים... --</option>
            </select>
        </div>

        <button type="submit" id="submitBtn">בצע שינוי</button>
    </form>
</div>

<script>
    // פונקציה להצגת רשימת משתמשים רק במידת הצורך
    function toggleUserSection() {
        const action = document.getElementById("actionSelect").value;
        const userSection = document.getElementById("userSelectionSection");
        userSection.style.display = (action === "ADD" || action === "REMOVE") ? "block" : "none";
    }

    // כאן תוכלי להוסיף את ה-fetch ל-Make שיביא את ה-JSON של השאילתות שלך
    // תוכלי להשתמש ב-Apps Script כ-API כדי להחזיר את הנתונים מ-SQL לפורטל
</script>

</body>
</html>
